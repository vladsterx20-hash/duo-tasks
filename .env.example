# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID двух пользователей через запятую (узнать: @userinfobot)
ALLOWED_IDS=111111111,222222222
# Postgres (Neon / Supabase / Railway / Render). Для облачных добавьте ?sslmode=require
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
# Публичный HTTPS-адрес приложения (после деплоя)
APP_URL=https://your-app.onrender.com
# Часовой пояс для текста уведомлений
TIMEZONE=Europe/Moscow
# За сколько минут до срока присылать напоминание
REMIND_MINUTES=30
PORT=3000
# ТОЛЬКО для локальной отладки в обычном браузере (не включать в проде)
# DEV_BYPASS=true
